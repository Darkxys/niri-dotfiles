# Optional local environment defaults.
# Copy values into your shell profile or ~/.config/environment.d/rice-local.conf.

# Niri startup wallpaper. The install script stows wallpapers to ~/Pictures/wallpapers.
NIRI_WALLPAPER=$HOME/Pictures/wallpapers/bg.jpg

# Enable wlsunset by setting both coordinates.
WLSUNSET_LAT=
WLSUNSET_LON=
WLSUNSET_TEMP_NIGHT=2500
WLSUNSET_TEMP_DAY=6200

# Cursor theme and size.
XCURSOR_THEME=Bibata-Modern-Classic
XCURSOR_SIZE=24

